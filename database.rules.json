{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$user": {
        ".write": "auth != null",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 16"
      }
    },
    "scores": {
      ".read": "auth != null",
      "$user": {
        ".write": "auth != null"
      }
    },
    "academic": {
      ".read": "auth != null",
      "questions": {
        "$q": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || (newData.child('s').isString() && newData.child('diff').isString())"
        }
      },
      "reports": {
        "$q": { ".write": "auth != null" }
      },
      "hidden": {
        "$q": { ".write": "auth != null" }
      }
    },
    "rooms": {
      "$game": {
        ".read": "auth != null",
        "$room": {
          ".write": "auth != null"
        }
      }
    }
  }
}
